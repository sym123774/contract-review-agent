OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
LLM_MODEL=qwen3.6:27b
EMBEDDING_MODEL=bge-m3
LLM_NUM_CTX=16384
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=300
LLM_ITEM_RETRY_LIMIT=1
AUTH_USER=admin
# Web login password (not an Ollama password). Set at least 12 characters in .env.local.
AUTH_PASS=
API_HOST=127.0.0.1
# Windows 上 8000 常被 Hyper-V 保留段占用（WinError 10013），可改为未保留端口
API_PORT=8000
REVIEW_MAX_WORKERS=1
REVIEW_MAX_PENDING=8
